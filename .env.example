# Copy to .env and fill in the values.
#   cp .env.example .env

# --- Database ---------------------------------------------------------------
POSTGRES_USER=mai
# REQUIRED. Choose your own; there is deliberately no default. This
# database holds your conversations, memories and entity graph.
POSTGRES_PASSWORD=
POSTGRES_DB=mai
POSTGRES_PORT=5432

# Read by the backend. Must use the asyncpg driver.
# In Docker the host is the compose service name `db`; running the backend on
# your own machine, it is localhost.
DATABASE_URL=postgresql+asyncpg://mai:CHANGE_ME@localhost:5432/mai

# --- LLM --------------------------------------------------------------------
# Which provider implementation to build. Must match a key in the factory
# registry (app/llm/factory.py). Stage 1 ships "groq".
# One of: groq | gemini | anthropic_api
# (claude_subscription is a reserved name and is always refused -- see
#  docs/stage4ff_provider_gateway.md for why.)
LLM_PROVIDER=groq

# REQUIRED. Get a key at https://console.groq.com/keys (starts "gsk_").
# Free tier: 30 requests/minute, 14,400/day, no credit card.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Available chat models: openai/gpt-oss-120b (default), openai/gpt-oss-20b,
# qwen/qwen3.8-27b. Change the model with this variable alone.
GROQ_MODEL=openai/gpt-oss-120b

# --- Gemini ---
# Set LLM_PROVIDER=gemini to use these. A Gemini API key from Google AI
# Studio (https://aistudio.google.com/apikey). Reached through Google's
# OpenAI-compatible endpoint and Mai's own policed HTTP client -- no Google
# SDK. Leave the key empty here; set it only in your untracked .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Anthropic API (Stage 4F-F) ---
# Set LLM_PROVIDER=anthropic_api to use these. An Anthropic *API* key, billed
# to an API account -- this is not a Claude Pro/Max subscription, and Mai
# cannot use one: Anthropic does not permit third-party products to
# authenticate with a claude.ai login.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-5

# --- Telegram adapter -------------------------------------------------------
# Optional. The webhook stays unavailable unless every value below is set.
# TELEGRAM_CONVERSATION_ID is the UUID of the existing Mai conversation used
# for the one allowed Telegram chat; it does not create a new user identity.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_CHAT_ID=
TELEGRAM_CONVERSATION_ID=

# --- Google Calendar, read-only (Stage 4F-G) ---
# A "Desktop app" OAuth client from the Google Cloud console. Optional.
# Mai requests exactly one scope: calendar.events.readonly. It cannot create,
# change or delete anything, and asks for no Gmail, Drive or Contacts access.
# Tokens are stored outside this file -- see MAI_CREDENTIAL_DIR.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/integrations/google/callback

# Gmail is a separate integration with a separate consent and a separate
# callback, so each one validates exactly one required scope set. Register
# BOTH redirect URIs in the Google Cloud console -- Google requires an exact
# match, and a Gmail grant arriving at the Calendar callback is refused.
#
# Gmail also needs https://www.googleapis.com/auth/gmail.readonly added to the
# OAuth consent screen. It is a Google *restricted* scope: it covers the whole
# mailbox, so a published app requesting it needs Google verification. A
# personal deployment in Testing mode with yourself as the only test user does
# not.
GOOGLE_GMAIL_REDIRECT_URI=http://127.0.0.1:8000/api/integrations/gmail/callback

# The timezone "tomorrow afternoon" is resolved in. An IANA name.
#
# A calendar day is a local idea. Left at UTC, "tomorrow" for someone in
# Asia/Kolkata runs from 05:30 tomorrow to 05:30 the day after -- missing
# their morning and including part of the next day. Set this to where the
# user actually is. An unknown name stops the process rather than falling
# back, because a silently wrong window gives plausible wrong answers.
MAI_TIMEZONE=UTC

# Shared across providers.
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# --- Memory (Stage 2A) ------------------------------------------------------
# Master switch for the memory subsystem. When false, the /api/memories routes
# are not registered and nothing is extracted.
MEMORY_ENABLED=true
# Automatic extraction after each completed turn. Disable to stop writing new
# memories while keeping existing ones readable.
MEMORY_EXTRACTION_ENABLED=true
# Candidates scoring below either threshold are discarded.
MEMORY_MIN_IMPORTANCE=5
MEMORY_MIN_CONFIDENCE=0.7

# Optional memory tuning (defaults shown; uncomment to override):
# Lexical similarity at or above this counts as a duplicate. Raising it stores
# more near-duplicates; lowering it risks merging genuinely distinct facts.
# MEMORY_DEDUP_THRESHOLD=0.82
# How many recent same-type memories a candidate is compared against.
# MEMORY_DEDUP_CANDIDATES=50
# MEMORY_EXTRACTION_TEMPERATURE=0.1
# MEMORY_EXTRACTION_MAX_TOKENS=1024

# --- Entities (Stage 2B) ----------------------------------------------------
# Entity extraction runs after a memory is stored. Disabling it leaves
# conversations and memories completely unaffected.
ENTITY_EXTRACTION_ENABLED=true
# Candidates the model is unsure about are discarded.
ENTITY_MIN_CONFIDENCE=0.7
# Upper bound per memory; a longer list means the model is over-extracting.
ENTITY_EXTRACTION_MAX_PER_MEMORY=10

# Optional entity tuning (defaults shown; uncomment to override):
# ENTITY_EXTRACTION_TEMPERATURE=0.1
# ENTITY_EXTRACTION_MAX_TOKENS=1024

# --- Relationships (Stage 2C) -----------------------------------------------
# Relationship extraction runs after entity extraction, and only when a memory
# has at least two entities to relate. Disabling it leaves conversations,
# memories and entities completely unaffected.
RELATIONSHIP_EXTRACTION_ENABLED=true
RELATIONSHIP_MIN_CONFIDENCE=0.7
RELATIONSHIP_EXTRACTION_MAX_PER_MEMORY=10

# Optional relationship tuning (defaults shown; uncomment to override):
# RELATIONSHIP_EXTRACTION_TEMPERATURE=0.1
# RELATIONSHIP_EXTRACTION_MAX_TOKENS=1024

# --- Context retrieval (Stage 2D) --------------------------------------------
# Retrieval runs on the request path before the chat call and adds NO model
# calls -- every step is a bounded database query. Disabling it leaves chat and
# recent-conversation context working exactly as before.
RETRIEVAL_ENABLED=true
# Budgets. Ranking happens first, so these decide what survives, not what is
# looked at.
RETRIEVAL_MAX_MEMORIES=10
RETRIEVAL_MAX_ENTITIES=10
RETRIEVAL_MAX_RELATIONSHIPS=10
RETRIEVAL_MAX_CONTEXT_CHARS=8000
# Upper bound on rows considered before ranking.
RETRIEVAL_CANDIDATE_POOL_SIZE=50

# Ranking weights (sum to 1.0). Relevance (text + entity + relationship = 0.70)
# deliberately outweighs metadata (importance + confidence + recency = 0.30),
# so an important but irrelevant memory cannot outrank a directly relevant one.
# RETRIEVAL_WEIGHT_TEXT=0.30
# RETRIEVAL_WEIGHT_ENTITY=0.25
# RETRIEVAL_WEIGHT_RELATIONSHIP=0.15
# RETRIEVAL_WEIGHT_IMPORTANCE=0.15
# RETRIEVAL_WEIGHT_CONFIDENCE=0.10
# RETRIEVAL_WEIGHT_RECENCY=0.05

# --- Context assembly (Stage 3A) ---------------------------------------------
# Stage 3A combines the current message, recent conversation and Stage 2D's
# ranked retrieval into one bounded ContextPackage. It adds no model calls and
# mutates nothing. Not yet injected into prompts -- that is Stage 3B.
CONTEXT_RECENT_MESSAGE_LIMIT=12
CONTEXT_MAX_MEMORY_ITEMS=10
CONTEXT_MAX_ENTITY_ITEMS=10
CONTEXT_MAX_RELATIONSHIP_ITEMS=10
# Final authority over every category limit. Characters for now; the accounting
# is isolated so token budgeting can replace it.
CONTEXT_MAX_TOTAL_CHARS=10000

# --- Application ------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
# "json" for structured logs, "console" for readable local output.
LOG_FORMAT=console
# How many stored messages are replayed to the model per turn.
MAX_CONTEXT_MESSAGES=40
# Comma-separated, or a JSON array.
CORS_ORIGINS=http://localhost:3000

# --- Optional tuning (sensible defaults; uncomment to override) --------------
# APP_NAME=Mai
# The system prompt prepended to every request.
# MAI_SYSTEM_PROMPT=You are Mai, a helpful personal AI assistant. Answer clearly and concisely.
# Echo every SQL statement to the log (noisy; debugging only).
# DB_ECHO=false
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10

# --- Ports ------------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- Frontend ---------------------------------------------------------------
# The backend URL as reached from the browser.
NEXT_PUBLIC_API_URL=http://localhost:8000

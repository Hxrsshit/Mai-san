# Copy to .env and fill in the values.
#   cp .env.example .env

# --- Database ---------------------------------------------------------------
POSTGRES_USER=mai
POSTGRES_PASSWORD=mai
POSTGRES_DB=mai
POSTGRES_PORT=5432

# Read by the backend. Must use the asyncpg driver.
# In Docker the host is the compose service name `db`; running the backend on
# your own machine, it is localhost.
DATABASE_URL=postgresql+asyncpg://mai:mai@localhost:5432/mai

# --- LLM --------------------------------------------------------------------
# Which provider implementation to build. Must match a key in the factory
# registry (app/llm/factory.py). Stage 1 ships "groq".
LLM_PROVIDER=groq

# REQUIRED. Get a key at https://console.groq.com/keys (starts "gsk_").
# Free tier: 30 requests/minute, 14,400/day, no credit card.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Available chat models: openai/gpt-oss-120b (default), openai/gpt-oss-20b,
# qwen/qwen3.8-27b. Change the model with this variable alone.
GROQ_MODEL=openai/gpt-oss-120b

# Shared across providers.
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# --- Application ------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
# "json" for structured logs, "console" for readable local output.
LOG_FORMAT=console
# How many stored messages are replayed to the model per turn.
MAX_CONTEXT_MESSAGES=40
# Comma-separated, or a JSON array.
CORS_ORIGINS=http://localhost:3000

# --- Optional tuning (sensible defaults; uncomment to override) --------------
# APP_NAME=Mai
# The system prompt prepended to every request.
# MAI_SYSTEM_PROMPT=You are Mai, a helpful personal AI assistant. Answer clearly and concisely.
# Echo every SQL statement to the log (noisy; debugging only).
# DB_ECHO=false
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10

# --- Ports ------------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- Frontend ---------------------------------------------------------------
# The backend URL as reached from the browser.
NEXT_PUBLIC_API_URL=http://localhost:8000

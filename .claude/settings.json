{
  "worktree": {
    "baseRef": "head"
  },
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.bak*)",
      "Read(.env.local)",
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git clean *)",
      "Bash(git stash *)",
      "Bash(git rebase *)",
      "Bash(git merge *)",
      "Bash(git restore *)",
      "Bash(git checkout -- *)",
      "Bash(git update-ref *)",
      "Bash(git reflog expire *)",
      "Bash(git gc *)",
      "Bash(git filter-branch *)",
      "Bash(git filter-repo *)",
      "Bash(git replace *)",
      "Bash(gh *)",
      "Bash(alembic *)",
      "Bash(.venv/bin/alembic *)",
      "Bash(backend/.venv/bin/alembic *)",
      "Bash(python -m alembic *)",
      "Bash(python3 -m alembic *)",
      "Bash(.venv/bin/python -m alembic *)",
      "Bash(backend/.venv/bin/python -m alembic *)"
    ],
    "ask": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git worktree *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git rm *)",
      "Bash(git config *)",
      "Bash(git tag *)",
      "Bash(git cherry-pick *)",
      "Bash(git revert *)",
      "Bash(git am *)",
      "Bash(git remote *)",
      "Bash(docker *)",
      "Bash(docker-compose *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm ci *)",
      "Bash(npm add *)",
      "Bash(npm update *)",
      "Bash(npm upgrade *)",
      "Bash(npm uninstall *)",
      "Bash(npm remove *)",
      "Bash(npm rm *)",
      "Bash(npm dedupe *)",
      "Bash(npm prune *)",
      "Bash(npm audit fix *)",
      "Bash(npx *)",
      "Bash(pip *)",
      "Bash(pip3 *)",
      "Bash(python -m pip *)",
      "Bash(python3 -m pip *)",
      "Bash(.venv/bin/pip *)",
      "Bash(.venv/bin/python -m pip *)",
      "Bash(backend/.venv/bin/pip *)",
      "Bash(backend/.venv/bin/python -m pip *)",
      "Bash(brew *)"
    ]
  }
}
